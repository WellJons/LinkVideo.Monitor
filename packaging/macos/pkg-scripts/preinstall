#!/bin/bash
set -u

APP="/Applications/LinkVideo.Monitor.app"
BIN="$APP/Contents/MacOS/LinkVideo.Monitor"
RELAUNCH_MARKER="/var/tmp/ru.linkvideo.monitor.relaunch"

app_processes() {
  /usr/bin/pgrep -f "^${APP}/Contents/" 2>/dev/null || true
}

main_processes() {
  /usr/bin/pgrep -f "^${BIN}([[:space:]]|$)" 2>/dev/null || true
}

# Never inherit a marker from a previous interrupted package installation.
/bin/rm -f "$RELAUNCH_MARKER"

main_pids="$(main_processes)"
if [[ -n "$main_pids" ]]; then
  console_user="$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)"
  if [[ -n "$console_user" && "$console_user" != "root" && "$console_user" != "loginwindow" ]]; then
    console_uid="$(/usr/bin/id -u "$console_user" 2>/dev/null || true)"
    case "$console_uid" in
      ''|*[!0-9]*) ;;
      *)
        /usr/bin/printf '%s\n%s\n' "$console_user" "$console_uid" > "$RELAUNCH_MARKER"
        /bin/chmod 600 "$RELAUNCH_MARKER"
        ;;
    esac
  fi
fi

# Terminate only processes launched from inside the installed application.
# The privileged updater (`osascript` -> `/usr/sbin/installer`) lives outside
# this prefix and therefore remains alive while the package replaces the app.
app_pids="$(app_processes)"
for pid in $app_pids; do
  /bin/kill -TERM "$pid" 2>/dev/null || true
done

if [[ -n "$app_pids" ]]; then
  /bin/sleep 1
fi

for pid in $(app_processes); do
  /bin/kill -KILL "$pid" 2>/dev/null || true
done

exit 0
